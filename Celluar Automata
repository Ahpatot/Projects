#include <SDL3/SDL.h>
#include <iostream>
#include <vector>
#include <stack>
#include <cstdlib>
#include <ctime>
#include <algorithm>

constexpr int GRID_SIZE = 10;
constexpr int CELL_SIZE = 50;
constexpr int WINDOW_SIZE = GRID_SIZE * CELL_SIZE;

struct Cell {
    bool top = true;
    bool bottom = true;
    bool left = true;
    bool right = true;
    bool visited = false;
};

struct Point {
    int x;
    int y;
};

Cell grid[GRID_SIZE][GRID_SIZE];
Point points[GRID_SIZE * GRID_SIZE];

void initializePoints() {
    int idx = 0;
    for (int y = 0; y < GRID_SIZE; ++y) {
        for (int x = 0; x < GRID_SIZE; ++x) {
            points[idx++] = {x, y};
        }
    }
}

void removeBorder(const Point& a, const Point& b) {
    if (a.x == b.x && std::abs(a.y - b.y) == 1) {
        int minY = std::min(a.y, b.y);
        int maxY = std::max(a.y, b.y);
        grid[minY][a.x].bottom = false;
        grid[maxY][a.x].top = false;
    } else if (a.y == b.y && std::abs(a.x - b.x) == 1) {
        int minX = std::min(a.x, b.x);
        int maxX = std::max(a.x, b.x);
        grid[a.y][minX].right = false;
        grid[a.y][maxX].left = false;
    }
}

void drawGrid(SDL_Renderer* renderer) {
    SDL_SetRenderDrawColor(renderer, 255, 255, 255, 255); // Beyaz çizgiler
    for (int y = 0; y < GRID_SIZE; ++y) {
        for (int x = 0; x < GRID_SIZE; ++x) {
            int px = x * CELL_SIZE;
            int py = y * CELL_SIZE;
            if (grid[y][x].top) {
                SDL_RenderLine(renderer, px, py, px + CELL_SIZE, py);
            }
            if (grid[y][x].bottom) {
                SDL_RenderLine(renderer, px, py + CELL_SIZE, px + CELL_SIZE, py + CELL_SIZE);
            }
            if (grid[y][x].left) {
                SDL_RenderLine(renderer, px, py, px, py + CELL_SIZE);
            }
            if (grid[y][x].right) {
                SDL_RenderLine(renderer, px + CELL_SIZE, py, px + CELL_SIZE, py + CELL_SIZE);
            }
        }
    }
}

std::vector<Point> getNeighbors(const Point& p) {
    std::vector<Point> result;
    if (p.x > 0) result.push_back({p.x - 1, p.y});
    if (p.x < GRID_SIZE - 1) result.push_back({p.x + 1, p.y});
    if (p.y > 0) result.push_back({p.x, p.y - 1});
    if (p.y < GRID_SIZE - 1) result.push_back({p.x, p.y + 1});
    return result;
}

std::vector<Point> getUnvisitedNeighbors(const Point& p) {
    std::vector<Point> neighbors = getNeighbors(p);
    std::vector<Point> unvisited;
    for (const auto& n : neighbors) {
        if (!grid[n.y][n.x].visited) {
            unvisited.push_back(n);
        }
    }
    return unvisited;
}

bool allNeighborsVisited(const Point& p) {
    std::vector<Point> neighbors = getNeighbors(p);
    for (const auto& n : neighbors) {
        if (!grid[n.y][n.x].visited) {
            return false;
        }
    }
    return true;
}

void generateMaze(Point start) {
    std::stack<Point> stack;
    Point origin = start;
    grid[origin.y][origin.x].visited = true;
    stack.push(origin);

    while (!stack.empty()) {
        origin = stack.top();
        std::vector<Point> unvisitedNeighbors = getUnvisitedNeighbors(origin);

        if (!unvisitedNeighbors.empty()) {
            // Rastgele bir komşu seç
            int idx = std::rand() % unvisitedNeighbors.size();
            Point next = unvisitedNeighbors[idx];

            // Duvarı kaldır
            removeBorder(origin, next);

            // Yeni orijini ziyaretli yap ve stack'e ekle
            grid[next.y][next.x].visited = true;
            stack.push(next);
        } else {
            // Tüm komşular ziyaretli, bir önceki orijine dön
            stack.pop();
        }
    }
}

int main(int argc, char* argv[]) {
    std::srand(static_cast<unsigned int>(std::time(nullptr)));

    SDL_Window* window = SDL_CreateWindow("Caged Grid", WINDOW_SIZE, WINDOW_SIZE, 0);
    SDL_Renderer* renderer = SDL_CreateRenderer(window, nullptr);

    initializePoints();

    // Rastgele bir başlangıç noktası seç
    int originIndex = std::rand() % (GRID_SIZE * GRID_SIZE);
    Point origin = points[originIndex];

    // Labirenti oluştur
    generateMaze(origin);

    bool running = true;
    SDL_Event event;
    while (running) {
        while (SDL_PollEvent(&event)) {
            if (event.type == SDL_EVENT_QUIT) {
                running = false;
            }
        }
        SDL_SetRenderDrawColor(renderer, 0, 0, 0, 255); // Siyah arka plan
        SDL_RenderClear(renderer);

        drawGrid(renderer);

        SDL_RenderPresent(renderer);
        SDL_Delay(16); // ~60 FPS
    }

    SDL_DestroyRenderer(renderer);
    SDL_DestroyWindow(window);
    SDL_Quit();
    return 0;
}
